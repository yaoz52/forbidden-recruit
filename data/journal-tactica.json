 "rules": {
  "Master of Descent": {
   "summary": "Can arrive by Deep Strike in the first Battle Turn if every Model in its Unit has the Infantry Type and Antigrav Sub-Type. Only one Unit per Army can use this in the same Battle Turn.",
   "ref": "Journal Tactica (EN)"
  },
  "Tip of the Spear": {
   "summary": "An Army whose Primary Detachment includes this Model may select one Planetfall Speartip Auxiliary Detachment (once per Army).",
   "ref": "Journal Tactica (EN)"
  },
  "Strato-vox": {
   "summary": "The Unit passes Reserves Tests automatically. While on the Battlefield, can make one Deep Strike Reserves Test automatically successful (that Unit must then Deep Strike).",
   "ref": "Journal Tactica (EN)"
  },
  "Archein of Wisdom": {
   "summary": "Gambit (Raldoron, in a Challenge): adds to his Focus Roll a bonus equal to the successful Hit Tests made against him earlier in the Challenge.",
   "ref": "Wahapedia (EN)"
  },
  "Battlefield Coordinators": {
   "summary": "Once per Turn, if this Unit is within 18\" of a friendly Unit making a Reaction, it can make an Intelligence Check to reduce that Reaction's cost.",
   "ref": "Wahapedia (EN)"
  },
  "Aflame (X)": {
   "summary": "If a Melee Attack with this rule wounds a Unit, it is 'aflame' until the end of the Phase: X is applied as an additional negative modifier to its Leadership Checks for that Combat.",
   "ref": "Wahapedia (EN)"
  },
  "Occulix Targeting Auspex": {
   "summary": "If the Model's Unit remained Stationary in the preceding Movement Phase, it gains Firing Protocols (2) when making a Shooting Attack.",
   "ref": "Wahapedia (EN)"
  },
  "Thermal diffraction field": {
   "summary": "Hits from Las, Plasma, Melta and Flame Weapons suffer -1 Strength against this Model; Breaching on its own Overload Misfire hits only applies on a 6+.",
   "ref": "Wahapedia (EN)"
  },
  "Saturnine Teleport Synchroniser": {
   "summary": "In Reserves, the Model gains Deep Strike if its Unit has been joined by a Model with a Saturnine teleportation transponder.",
   "ref": "Wahapedia (EN)"
  },
  "Warpfire Mantle": {
   "summary": "After the Attacks Sub-Phase of a Shooting Phase, if Models with warpfire mantles passed an Armour or Invulnerable Save against Shooting, nearby Units within 8\" can suffer wounds.",
   "ref": "Wahapedia (EN)"
  },
  "Saturnine teleportation transponder": {
   "summary": "The Model has Deep Strike; while it has joined a Saturnine Terminator Squad in Reserves, the Saturnine Terminators in that Unit also gain Deep Strike.",
   "ref": "Wahapedia (EN)"
  },
  "Smokescreen": {
   "summary": "Trait: allows the Smokescreen Advanced Reaction (1 Reaction point) to gain Shrouded Damage Mitigation Rolls against a Shooting Attack.",
   "ref": "Wahapedia (EN)"
  }
 },
